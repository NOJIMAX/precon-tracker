# ── データベース（Supabase）────────────────────────────
# Supabase の Project Settings → Database → Connection string → "Transaction pooler" の URI
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# テスト専用のデータベース（本番と必ず別にする。npm test はこのDBを毎回作り直します）
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracker_test
DB_POOL_MAX=5

# ── 定期実行 ───────────────────────────────────────
# Vercel Cron が /api/cron/daily を呼ぶときの合言葉（Vercel の環境変数にも同じ値を設定）
CRON_SECRET=ランダムな長い文字列
# 1回の実行で使える時間（ミリ秒）。Vercel では 270000（4分30秒）以下
JOB_TIME_BUDGET_MS=270000
# 公式デッキリストの変更チェックを1回に何件まで行うか（7日ごと）
DECK_CHECKS_PER_RUN=3

# ── 画面のアクセス制限（任意）──────────────────────────
# 設定すると Basic 認証がかかります（"ユーザー名:パスワード"、半角英数字）
APP_BASIC_AUTH=

# ── 晴れる屋の自動取得（既定は無効）─────────────────────
# 晴れる屋から自動取得の許可を得た場合のみ enabled にしてください（README「晴れる屋の自動取得」参照）
HARERUYA_AUTO_FETCH=disabled
HARERUYA_MIN_INTERVAL_MS=3000
HARERUYA_MAX_REQUESTS_PER_RUN=300

# ── その他 ─────────────────────────────────────────
# 外部サイトへアクセスするときの User-Agent
HTTP_USER_AGENT=PreconBuybackTracker/0.1 (+internal shop tool; low-frequency)
# MTGJSON の取得元（通常は変更不要）
MTGJSON_BASE_URL=https://mtgjson.com/api/v5
